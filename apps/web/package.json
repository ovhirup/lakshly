{
  "name": "@lakshly/web",
  "version": "0.1.0",
  "private": true,
  "description": "Lakshly web MVP: local-first, client-only PWA. Synthetic demo data only.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "gen:types": "json2ts -i ../../packages/schema/lakshly.schema.json -o lib/schema.gen.ts --bannerComment \"/* Generated from packages/schema/lakshly.schema.json. Do not edit. */\"",
    "predev": "npm run sync-data",
    "dev": "next dev",
    "prebuild": "npm run sync-data",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run sync-data",
    "test": "vitest run",
    "pretypecheck": "npm run sync-data",
    "prelint": "npm run sync-data"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
